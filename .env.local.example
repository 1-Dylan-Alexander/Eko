# Ēko Environment Variables
# Copy this file to .env.local and fill in all values before running the app
# NEVER commit .env.local to version control

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-side only — never expose to browser

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=                 # server-side only
CLERK_WEBHOOK_SECRET=             # from Clerk dashboard → Webhooks → signing secret

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=                # server-side only
STRIPE_WEBHOOK_SECRET=            # server-side only

# Resend
RESEND_API_KEY=                   # server-side only

# Sentry
NEXT_PUBLIC_SENTRY_DSN=            # from sentry.io → project → Client Keys (DSN)
SENTRY_ORG=                        # your Sentry org slug
SENTRY_PROJECT=                    # your Sentry project slug
SENTRY_AUTH_TOKEN=                 # from sentry.io → settings → auth tokens

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
